# datasets and training artifacts (keep under DATA_ROOT/OUTPUT_ROOT on scratch when possible)
datasets/
data/
amazon-2014/
amazon-2023/
outputs/
/results/
models/
# "models/" above is for training-output dirs, but it also matches the source
# package src/models/; re-include it so NEW source files there are tracked
# (already-tracked files were unaffected).
!src/models/
wandb/
*.ckpt
*.pkl

# python / hydra / ray
__pycache__/
*.py[cod]
.pytest_cache/
.hydra/
.venv/
*.egg-info/

# logs and env
*.log
.env
jobs/wandb.env
.DS_Store

# cursor (if ever created inside repo)
.cursor/

# training artifacts written into repo dir by test.py
lightning_logs/

# beyond-accuracy dumps: the raw per-user Top-K npz (the depth-20 "*_topk.npz", the
# per-item content embeddings, and the scored depth-100 npz) are large regenerable
# intermediates (~240 MB on Arts/Sports/Beauty). What they feed IS committed: the
# beyond-accuracy CSVs, the PMI/MBR/oracle JSONs, and the small exact_catalog rank npz
# the figures read (exact_catalog_*.npz, a few hundred KB each).
reports/extensions/**/embeddings.npy
reports/extensions/**/*topk100.npz
reports/extensions/**/*_topk.npz

# AI assistant artifacts and local working notes (local only, never pushed)
CLAUDE.md
CLAUDE.local.md
*.local.md
AGENTS.md
GEMINI.md
.claude/
.context/
