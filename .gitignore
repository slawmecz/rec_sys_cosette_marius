# datasets and training artifacts (keep under DATA_ROOT/OUTPUT_ROOT on scratch when possible)
datasets/
data/
amazon-2014/
amazon-2023/
outputs/
/results/
models/
# "models/" above is for training-output dirs, but it also matches the source
# package src/models/; re-include it so NEW source files there are tracked
# (already-tracked files were unaffected).
!src/models/
wandb/
*.ckpt
*.pkl

# python / hydra / ray
__pycache__/
*.py[cod]
.pytest_cache/
.hydra/
.venv/
*.egg-info/

# logs and env
*.log
.env
jobs/wandb.env
.DS_Store

# cursor (if ever created inside repo)
.cursor/

# training artifacts written into repo dir by test.py
lightning_logs/

# beyond-accuracy Top-K dumps: keep the small support tables + Top-K npz, but not
# the large per-item content embeddings (ILD is already captured in the CSVs).
reports/extensions/topk/**/embeddings.npy
reports/extensions/topk_logitadj_*/**/embeddings.npy
reports/extensions/topk_distill_*/**/embeddings.npy
# Arts-2023 (~90k catalog) at-scale dumps: the content embeddings (1.3 GB) and the
# scored depth-100 dumps (1.2 GB) are regenerable intermediates -- the PMI/MBR/oracle
# results they feed are all committed as CSVs/JSONs. Keep the depth-20 Top-K npz +
# support tables for metric re-derivation.
reports/extensions/topk_arts/**/embeddings.npy
reports/extensions/topk_arts/**/*topk100.npz

# AI assistant artifacts and local working notes (local only, never pushed)
CLAUDE.md
CLAUDE.local.md
*.local.md
AGENTS.md
GEMINI.md
.claude/
.context/
