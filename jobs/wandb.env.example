# WandB configuration for TRAINING (batch jobs) and for EXPORTING curves.
#
# Setup (one-time):
#   cp jobs/wandb.env.example jobs/wandb.env
#   # Edit the values below. Do NOT commit wandb.env.
#
# Used by:
#   - jobs/env_common.sh  → training logs metrics during sbatch jobs
#   - scripts/export_metrics_for_report.py --source wandb  → downloads curves
#                                     into reports/metrics/ (read-only API)
#
# NOT required to open notebooks/replication_report.ipynb if reports/metrics/
# already contains CSV files.
#
# API key: https://wandb.ai/authorize

export WANDB_API_KEY=your_key_here
export WANDB_ENTITY=your_wandb_username_or_team
export WANDB_PROJECT=cosette-and-marius
export WANDB_MODE=online
